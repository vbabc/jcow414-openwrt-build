+/* This RAM experiment expires even if the controlling browser disappears. */
+#define JCOW414_ACTIVATION_SECONDS 180
+
+static int airoha_xpon_manual_stop(struct xpon_priv *priv)
+{
+	int ret, fe_ret;
+
+	/* Close all software admission and physical TX before draining work. */
+	WRITE_ONCE(priv->activation_armed, false);
+	ret = airoha_xpon_phy_set_activation_arm(priv->phy, false);
+	if (ret)
+		dev_err(priv->dev, "failed to assert manual TX inhibit: %d\n", ret);
+	airoha_gpon_omci_stop(&priv->omci);
+	if (READ_ONCE(priv->mac_enabled) || priv->phy_powered)
+		gpon_disable(priv);
+	gpon_write(priv, GPON_INT_ENABLE, 0);
+	gpon_set_bits(priv, GPON_MBI_MPI_STOP,
+		      MBI_RX_STOP | MBI_TX_STOP | MPI_RX_STOP | MPI_TX_STOP);
+	fe_ret = gpon_set_fe_datapath(priv, false);
+	if (fe_ret)
+		dev_err(priv->dev, "failed to stop GPON FE datapath: %d\n", fe_ret);
+	return ret ? ret : fe_ret;
+}
+
+static void airoha_xpon_activation_expiry(struct work_struct *work)
+{
+	struct xpon_priv *priv = container_of(to_delayed_work(work),
+		struct xpon_priv, activation_expiry_work);
+
+	mutex_lock(&priv->activation_lock);
+	airoha_xpon_manual_stop(priv);
+	mutex_unlock(&priv->activation_lock);
+	dev_info(priv->dev, "manual GPON activation lease expired; TX disabled\n");
+}
+
+static int airoha_xpon_manual_start(struct xpon_priv *priv)
+{
+	int ret;
+
+	if (!priv->manual_activation || priv->control_diagnostic ||
+	    priv->mode != AIROHA_XPON_MODE_GPON)
+		return -EOPNOTSUPP;
+	if (READ_ONCE(priv->activation_armed))
+		return -EALREADY;
+	if (READ_ONCE(priv->started))
+		return -EBUSY;
+	/* Require an explicit runtime serial apply, not the generic default. */
+	if (!READ_ONCE(priv->activation_identity_configured))
+		return -EINVAL;
+	ret = airoha_xpon_phy_tx_inhibited(priv->phy);
+	if (ret != 1)
+		return ret < 0 ? ret : -EIO;
+	ret = airoha_xpon_phy_set_activation_arm(priv->phy, true);
+	if (ret)
+		return ret;
+	WRITE_ONCE(priv->activation_armed, true);
+	ret = airoha_gpon_omci_start(&priv->omci);
+	if (ret) {
+		airoha_xpon_manual_stop(priv);
+		return ret;
+	}
+	mod_delayed_work(system_wq, &priv->activation_expiry_work,
+			 JCOW414_ACTIVATION_SECONDS * HZ);
+	return 0;
+}
+
+static ssize_t activation_show(struct device *dev,
+			       struct device_attribute *attr, char *buf)
+{
+	struct xpon_priv *priv = dev_get_drvdata(dev);
+
+	if (!priv || !priv->manual_activation)
+		return -EOPNOTSUPP;
+	return sysfs_emit(buf,
+		"armed=%u identity_configured=%u lease_seconds=%u started=%u mac_enabled=%u tx_disabled=%d activation=%#x int_enable=%#x fifo_used=%u rx_gtc=%u\n",
+		READ_ONCE(priv->activation_armed),
+		READ_ONCE(priv->activation_identity_configured),
+		JCOW414_ACTIVATION_SECONDS, READ_ONCE(priv->started),
+		READ_ONCE(priv->mac_enabled),
+		airoha_xpon_phy_tx_inhibited(priv->phy),
+		gpon_read(priv, GPON_ACTIVATION_ST),
+		gpon_read(priv, GPON_INT_ENABLE),
+		gpon_read(priv, GPON_PLOAMd_FIFO_STS) & PLOAMd_FIFO_USED_MASK,
+		gpon_read(priv, GPON_DBG_RX_GTC_CNT));
+}
+
+static ssize_t activation_store(struct device *dev,
+				struct device_attribute *attr,
+				const char *buf, size_t count)
+{
+	struct xpon_priv *priv = dev_get_drvdata(dev);
+	bool arm;
+	int ret;
+
+	if (!capable(CAP_NET_ADMIN))
+		return -EPERM;
+	if (!priv || !priv->manual_activation)
+		return -EOPNOTSUPP;
+	ret = kstrtobool(buf, &arm);
+	if (ret)
+		return ret;
+	/* Never wait for the expiry worker while holding its mutex. */
+	if (!arm)
+		cancel_delayed_work_sync(&priv->activation_expiry_work);
+	mutex_lock(&priv->activation_lock);
+	if (arm)
+		ret = airoha_xpon_manual_start(priv);
+	else
+		ret = airoha_xpon_manual_stop(priv);
+	mutex_unlock(&priv->activation_lock);
+	return ret ? ret : (ssize_t)count;
+}
