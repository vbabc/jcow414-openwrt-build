From: JCOW414 diagnostic build
Subject: [PATCH] add single-owner TX-inhibited PHY and MAC diagnostics

--- a/drivers/net/optical/airoha/en7571_main.c
+++ b/drivers/net/optical/airoha/en7571_main.c
@@ -21,6 +21,8 @@
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/property.h>
