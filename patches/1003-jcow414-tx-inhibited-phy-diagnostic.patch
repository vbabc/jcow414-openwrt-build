From: JCOW414 diagnostic build
Subject: [PATCH] add single-owner TX-inhibited digital PHY diagnostic

--- a/drivers/net/optical/airoha/en7571_main.c
+++ b/drivers/net/optical/airoha/en7571_main.c
@@ -21,6 +21,8 @@
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/property.h>
+#include <linux/phy/phy.h>
+#include <linux/phy/phy-airoha-xpon.h>
 #include <linux/seq_file.h>
 #include <linux/slab.h>
 #include <linux/string.h>
@@ -467,7 +469,7 @@
 
 /* Read-only telemetry surface for the transmitter-inhibited bench test. */
 static const struct airoha_lddla_ops en7571_frontend_diag_ops = {
-	.name = "en7571-frontend-diag",
+	.name = "en7571_frontend_diag",
 	.part_number = "EN7571-LDDLA",
 	.serial = "EN7571SN00000001",
 	.date_code = "260609",
@@ -532,12 +534,22 @@
 	return true;
 }
 
+static void en7571_diag_phy_release(void *data)
+{
+	struct en7571_priv *priv = data;
+
+	if (priv->diag_phy_powered)
+		phy_power_off(priv->diag_phy);
+	if (priv->diag_phy_initialized)
+		phy_exit(priv->diag_phy);
+}
+
 static int en7571_probe(struct i2c_client *client)
 {
 	struct device *dev = &client->dev;
 	struct en7571_priv *priv;
 	struct gpio_desc *tx_disable = NULL;
-	bool frontend_diag;
+	bool frontend_diag, phy_diag;
 	int ret;
 
 	if (!i2c_check_functionality(client->adapter, I2C_FUNC_I2C))
@@ -588,9 +600,21 @@
 		return 0;
 	}
 
-	frontend_diag = device_property_read_bool(dev, "airoha,frontend-diagnostic");
-	if (frontend_diag) {
-		/* Request a real, active-high board disable before any chip init. */
+	phy_diag = device_property_read_bool(dev, "airoha,phy-diagnostic");
+	frontend_diag = phy_diag ||
+		device_property_read_bool(dev, "airoha,frontend-diagnostic");
+	if (phy_diag) {
+		/* PHY probe owns and asserts GPIO16; EN7571 never requests it. */
+		priv->diag_phy = devm_phy_get(dev, "xpon");
+		if (IS_ERR(priv->diag_phy))
+			return dev_err_probe(dev, PTR_ERR(priv->diag_phy),
+					     "diagnostic PHY is not ready\n");
+		ret = airoha_xpon_phy_tx_inhibited(priv->diag_phy);
+		if (ret != 1)
+			return dev_err_probe(dev, ret < 0 ? ret : -EIO,
+					     "PHY must hold TX-disable before frontend init\n");
+	} else if (frontend_diag) {
+		/* Standalone frontend diagnostic retains its sole GPIO ownership. */
 		tx_disable = devm_gpiod_get(dev, "tx-disable", GPIOD_OUT_HIGH);
 		if (IS_ERR(tx_disable))
 			return dev_err_probe(dev, PTR_ERR(tx_disable),
@@ -607,10 +631,34 @@
 		return dev_err_probe(dev, ret, "device init failed\n");
 
 	if (frontend_diag) {
-		if (gpiod_get_value_cansleep(tx_disable) != 1)
-			return dev_err_probe(dev, -EIO,
+		ret = phy_diag ? airoha_xpon_phy_tx_inhibited(priv->diag_phy) :
+			gpiod_get_value_cansleep(tx_disable);
+		if (ret != 1)
+			return dev_err_probe(dev, ret < 0 ? ret : -EIO,
 					     "TX-disable GPIO lost after initialization\n");
 		priv->lddla.ops = &en7571_frontend_diag_ops;
+	}
+	if (phy_diag) {
+		ret = phy_init(priv->diag_phy);
+		if (ret)
+			return dev_err_probe(dev, ret, "diagnostic PHY init failed\n");
+		priv->diag_phy_initialized = true;
+		ret = devm_add_action_or_reset(dev, en7571_diag_phy_release, priv);
+		if (ret)
+			return ret;
+		ret = phy_set_mode_ext(priv->diag_phy, PHY_MODE_ETHERNET,
+				       AIROHA_XPON_PHY_SUBMODE_GPON);
+		if (ret)
+			return dev_err_probe(dev, ret, "diagnostic PHY mode failed\n");
+		ret = phy_power_on(priv->diag_phy);
+		if (ret)
+			return dev_err_probe(dev, ret, "diagnostic PHY power-on failed\n");
+		priv->diag_phy_powered = true;
+		ret = airoha_xpon_phy_tx_inhibited(priv->diag_phy);
+		if (ret != 1)
+			return dev_err_probe(dev, ret < 0 ? ret : -EIO,
+					     "TX-disable lost after digital PHY configuration\n");
+		dev_info(dev, "TX-inhibited digital PHY configured after frontend init\n");
 	}
 
 	ret = lddla_frontend_register(&priv->lddla);
--- a/drivers/net/optical/airoha/en7571.h
+++ b/drivers/net/optical/airoha/en7571.h
@@ -33,8 +33,13 @@
  * Per-device state for one EN7571 LDDLA controller.  The shared airoha_lddla
  * object (transport / flash / hwmon / SFP) must be the first member.
  */
+struct phy;
+
 struct en7571_priv {
 	struct airoha_lddla lddla;
+	struct phy *diag_phy;
+	bool diag_phy_initialized;
+	bool diag_phy_powered;
 
 	/* 1 Hz periodic state machine. */
 	struct delayed_work tick_work;
--- a/drivers/phy/airoha/phy-airoha-xpon.c
+++ b/drivers/phy/airoha/phy-airoha-xpon.c
@@ -20,6 +20,7 @@
 #include <linux/property.h>
 #include <linux/regmap.h>
 #include <linux/reset.h>
+#include <linux/sysfs.h>
 #include <linux/workqueue.h>
 
 #define ECONET_XPON_PHY_MIN_SIZE		0x0600
@@ -176,6 +177,7 @@
 	u32 trans_invert;
 	enum airoha_xpon_phy_submode submode;
 	struct delayed_work ready_work;
+	bool tx_inhibited_diagnostic;
 	bool initialized;
 	bool powered;
 	bool ready_reported;
@@ -588,6 +590,10 @@
 	if (!priv->tx_disable_gpio)
 		return;
 
+	/* Diagnostic mode must never release the physical transmit inhibit. */
+	if (priv->tx_inhibited_diagnostic)
+		enable = false;
+
 	/* TX_DISABLE is described using its asserted (disable) polarity. */
 	gpiod_set_value_cansleep(priv->tx_disable_gpio, !enable);
 }
@@ -603,10 +609,26 @@
 	if (!priv)
 		return -ENODEV;
 
+	if (priv->tx_inhibited_diagnostic && enable)
+		return -EPERM;
 	airoha_xpon_phy_set_tx_gpio(priv, enable);
 	return 0;
 }
 EXPORT_SYMBOL_GPL(airoha_xpon_phy_set_tx_enable);
+
+/* Readback admission for the EN7571 diagnostic consumer; no GPIO sharing. */
+int airoha_xpon_phy_tx_inhibited(struct phy *phy)
+{
+	struct airoha_xpon_phy *priv;
+
+	if (!phy)
+		return -EINVAL;
+	priv = phy_get_drvdata(phy);
+	if (!priv || !priv->tx_inhibited_diagnostic)
+		return -EOPNOTSUPP;
+	return gpiod_get_value_cansleep(priv->tx_disable_gpio);
+}
+EXPORT_SYMBOL_GPL(airoha_xpon_phy_tx_inhibited);
 
 static void
 airoha_xpon_phy_set_vcc_enabled(struct airoha_xpon_phy *priv, bool enable)
@@ -1121,6 +1143,9 @@
 	 */
 	airoha_xpon_phy_set_vcc_enabled(priv, true);
 	airoha_xpon_phy_set_tx_gpio(priv, false);
+	if (priv->tx_inhibited_diagnostic &&
+	    gpiod_get_value_cansleep(priv->tx_disable_gpio) != 1)
+		return -EIO;
 
 	dev_info(priv->dev, "configuring %s xPON PHY\n",
 		 priv->submode == AIROHA_XPON_PHY_SUBMODE_GPON ?
@@ -1131,6 +1156,11 @@
 		goto err_power;
 
 	airoha_xpon_phy_set_tx_gpio(priv, true);
+	if (priv->tx_inhibited_diagnostic &&
+	    gpiod_get_value_cansleep(priv->tx_disable_gpio) != 1) {
+		ret = -EIO;
+		goto err_power;
+	}
 
 	WRITE_ONCE(priv->powered, true);
 	priv->ready_reported = false;
@@ -1153,8 +1183,11 @@
 	 * Absence of light is a link condition, not a power-on failure.
 	 * Keep the digital PHY configured and monitor/recover it periodically.
 	 */
-	mod_delayed_work(system_wq, &priv->ready_work,
-			 msecs_to_jiffies(XPON_READY_RECOVERY_MS));
+	if (priv->tx_inhibited_diagnostic)
+		dev_info(priv->dev, "TX-inhibited PHY diagnostic; no recovery worker\n");
+	else
+		mod_delayed_work(system_wq, &priv->ready_work,
+				 msecs_to_jiffies(XPON_READY_RECOVERY_MS));
 	return 0;
 
 err_power:
@@ -1225,6 +1258,34 @@
 	return invert;
 }
 
+static ssize_t diagnostic_state_show(struct device *dev,
+				     struct device_attribute *attr, char *buf)
+{
+	struct airoha_xpon_phy *priv = dev_get_drvdata(dev);
+	int inhibited;
+
+	if (!priv || !priv->tx_inhibited_diagnostic)
+		return -ENODEV;
+	inhibited = gpiod_get_value_cansleep(priv->tx_disable_gpio);
+	if (inhibited < 0)
+		return inhibited;
+	if (!READ_ONCE(priv->powered))
+		return sysfs_emit(buf, "powered=0 tx_disabled=%d\n", inhibited);
+	return sysfs_emit(buf,
+			  "initialized=%u powered=1 tx_disabled=%d state=%u los=%u\n",
+			  priv->initialized, inhibited,
+			  airoha_xpon_phy_state(priv), airoha_xpon_phy_los(priv));
+}
+static DEVICE_ATTR_RO(diagnostic_state);
+
+static struct attribute *airoha_xpon_diag_attrs[] = {
+	&dev_attr_diagnostic_state.attr,
+	NULL,
+};
+static const struct attribute_group airoha_xpon_diag_group = {
+	.attrs = airoha_xpon_diag_attrs,
+};
+
 static int airoha_xpon_phy_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -1233,6 +1294,7 @@
 	struct airoha_xpon_phy *priv;
 	struct resource *res;
 	struct phy *phy;
+	int ret;
 
 	soc = device_get_match_data(dev);
 	if (!soc)
@@ -1244,6 +1306,8 @@
 
 	priv->dev = dev;
 	priv->soc = soc;
+	priv->tx_inhibited_diagnostic =
+		device_property_read_bool(dev, "airoha,tx-inhibited-diagnostic");
 	priv->submode = AIROHA_XPON_PHY_SUBMODE_GPON;
 	priv->trans_invert = airoha_xpon_phy_trans_invert(dev);
 	spin_lock_init(&priv->counter_lock);
@@ -1303,6 +1367,11 @@
 		return dev_err_probe(dev, PTR_ERR(provider),
 				     "failed to register xPON PHY provider\n");
 
+	if (priv->tx_inhibited_diagnostic) {
+		ret = devm_device_add_group(dev, &airoha_xpon_diag_group);
+		if (ret)
+			return ret;
+	}
 	dev_info(dev, "%s xPON PHY registered at %pR\n", soc->name, res);
 	return 0;
 }
--- a/include/linux/phy/phy-airoha-xpon.h
+++ b/include/linux/phy/phy-airoha-xpon.h
@@ -43,6 +43,8 @@
 	struct phy *phy, enum airoha_xpon_phy_gpon_oper_state state);
 int airoha_xpon_phy_set_gpon_bit_delay(struct phy *phy, u8 delay);
 int airoha_xpon_phy_set_tx_enable(struct phy *phy, bool enable);
+/* Diagnostic-only readback; returns 1 when the sole PHY owner holds inhibit. */
+int airoha_xpon_phy_tx_inhibited(struct phy *phy);
 int airoha_xpon_phy_set_tx_calibration_mode(struct phy *phy, bool enable);
 
 #endif /* __LINUX_PHY_AIROHA_XPON_H */
