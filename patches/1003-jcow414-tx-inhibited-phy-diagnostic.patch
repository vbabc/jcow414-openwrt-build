+#include <linux/phy/phy-airoha-xpon.h>
 #include <linux/seq_file.h>
 #include <linux/slab.h>
 #include <linux/string.h>
@@ -467,7 +469,7 @@
 
 /* Read-only telemetry surface for the transmitter-inhibited bench test. */
 static const struct airoha_lddla_ops en7571_frontend_diag_ops = {
-	.name = "en7571-frontend-diag",
+	.name = "en7571_frontend_diag",
 	.part_number = "EN7571-LDDLA",
 	.serial = "EN7571SN00000001",
 	.date_code = "260609",
@@ -532,12 +534,22 @@
 	return true;
 }
 
+static void en7571_diag_phy_release(void *data)
+{
+	struct en7571_priv *priv = data;
+
+	if (priv->diag_phy_powered)
+		phy_power_off(priv->diag_phy);
+	if (priv->diag_phy_initialized)
+		phy_exit(priv->diag_phy);
+}
+
 static int en7571_probe(struct i2c_client *client)
 {
 	struct device *dev = &client->dev;
 	struct en7571_priv *priv;
 	struct gpio_desc *tx_disable = NULL;
-	bool frontend_diag;
+	bool frontend_diag, phy_diag;
 	int ret;
 
 	if (!i2c_check_functionality(client->adapter, I2C_FUNC_I2C))
@@ -588,9 +600,21 @@
 		return 0;
 	}
 
-	frontend_diag = device_property_read_bool(dev, "airoha,frontend-diagnostic");
-	if (frontend_diag) {
-		/* Request a real, active-high board disable before any chip init. */
+	phy_diag = device_property_read_bool(dev, "airoha,phy-diagnostic");
+	frontend_diag = phy_diag ||
+		device_property_read_bool(dev, "airoha,frontend-diagnostic");
+	if (phy_diag) {
+		/* PHY probe owns and asserts GPIO16; EN7571 never requests it. */
+		priv->diag_phy = devm_phy_get(dev, "xpon");
+		if (IS_ERR(priv->diag_phy))
+			return dev_err_probe(dev, PTR_ERR(priv->diag_phy),
+					     "diagnostic PHY is not ready\n");
+		ret = airoha_xpon_phy_tx_inhibited(priv->diag_phy);
+		if (ret != 1)
+			return dev_err_probe(dev, ret < 0 ? ret : -EIO,
+					     "PHY must hold TX-disable before frontend init\n");
+	} else if (frontend_diag) {
+		/* Standalone frontend diagnostic retains its sole GPIO ownership. */
 		tx_disable = devm_gpiod_get(dev, "tx-disable", GPIOD_OUT_HIGH);
 		if (IS_ERR(tx_disable))
 			return dev_err_probe(dev, PTR_ERR(tx_disable),
@@ -607,10 +631,34 @@
 		return dev_err_probe(dev, ret, "device init failed\n");
 
 	if (frontend_diag) {
-		if (gpiod_get_value_cansleep(tx_disable) != 1)
-			return dev_err_probe(dev, -EIO,
+		ret = phy_diag ? airoha_xpon_phy_tx_inhibited(priv->diag_phy) :
+			gpiod_get_value_cansleep(tx_disable);
+		if (ret != 1)
+			return dev_err_probe(dev, ret < 0 ? ret : -EIO,
 					     "TX-disable GPIO lost after initialization\n");
 		priv->lddla.ops = &en7571_frontend_diag_ops;
+	}
+	if (phy_diag) {
+		ret = phy_init(priv->diag_phy);
+		if (ret)
+			return dev_err_probe(dev, ret, "diagnostic PHY init failed\n");
+		priv->diag_phy_initialized = true;
+		ret = devm_add_action_or_reset(dev, en7571_diag_phy_release, priv);
+		if (ret)
+			return ret;
+		ret = phy_set_mode_ext(priv->diag_phy, PHY_MODE_ETHERNET,
+				       AIROHA_XPON_PHY_SUBMODE_GPON);
+		if (ret)
+			return dev_err_probe(dev, ret, "diagnostic PHY mode failed\n");
+		ret = phy_power_on(priv->diag_phy);
+		if (ret)
+			return dev_err_probe(dev, ret, "diagnostic PHY power-on failed\n");
+		priv->diag_phy_powered = true;
+		ret = airoha_xpon_phy_tx_inhibited(priv->diag_phy);
+		if (ret != 1)
+			return dev_err_probe(dev, ret < 0 ? ret : -EIO,
+					     "TX-disable lost after digital PHY configuration\n");
+		dev_info(dev, "TX-inhibited digital PHY configured after frontend init\n");
 	}
 
 	ret = lddla_frontend_register(&priv->lddla);
